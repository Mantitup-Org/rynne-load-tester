# Copy to .env for local runs (never commit .env)
WORKER_URL=http://127.0.0.1:8787
APP_URL=http://127.0.0.1:3000

# Only for Worker routes that require the internal secret (e.g. /api/events/slug/:slug)
# Copy from rynne-v2/apps/backend/.env.local — do not commit.
INTERNAL_API_SECRET=

# Optional fixed slug for public-event scenario
LOADTEST_EVENT_SLUG=

# Defaults
LOADTEST_CONNECTIONS=50
LOADTEST_DURATION=30
LOADTEST_WORKERS=2
